{
  "name": "earth-pattern",
  "element": "earth",
  "description": "Motif source Terre défini proportionnellement à une longueur de référence length = L.",
  "parameters": {
    "length": {
      "symbol": "L",
      "description": "Longueur de référence du motif M0-M7."
    },
    "offsetX": {
      "symbol": "X0",
      "description": "Translation horizontale."
    },
    "offsetY": {
      "symbol": "Y0",
      "description": "Translation verticale."
    }
  },
  "screenTransform": {
    "x": "offsetX + normalizedX * length",
    "y": "offsetY - normalizedY * length"
  },
  "origin": "M0",
  "endPoint": "M7",
  "points": [
    {
      "id": "M0",
      "normalized": [
        "0",
        "0"
      ],
      "x": "offsetX",
      "y": "offsetY"
    },
    {
      "id": "M1",
      "normalized": [
        "1/6",
        "1/4"
      ],
      "x": "offsetX + length / 6",
      "y": "offsetY - length / 4"
    },
    {
      "id": "M2",
      "normalized": [
        "1/4",
        "3/8"
      ],
      "x": "offsetX + length / 4",
      "y": "offsetY - 3 * length / 8"
    },
    {
      "id": "M3",
      "normalized": [
        "1/3",
        "1/4"
      ],
      "x": "offsetX + length / 3",
      "y": "offsetY - length / 4"
    },
    {
      "id": "M4",
      "normalized": [
        "2/3",
        "1/4"
      ],
      "x": "offsetX + 2 * length / 3",
      "y": "offsetY - length / 4"
    },
    {
      "id": "M5",
      "normalized": [
        "3/4",
        "3/8"
      ],
      "x": "offsetX + 3 * length / 4",
      "y": "offsetY - 3 * length / 8"
    },
    {
      "id": "M6",
      "normalized": [
        "5/6",
        "1/4"
      ],
      "x": "offsetX + 5 * length / 6",
      "y": "offsetY - length / 4"
    },
    {
      "id": "M7",
      "normalized": [
        "1",
        "0"
      ],
      "x": "offsetX + length",
      "y": "offsetY"
    }
  ],
  "segments": [
    [
      "M0",
      "M1"
    ],
    [
      "M1",
      "M2"
    ],
    [
      "M2",
      "M3"
    ],
    [
      "M3",
      "M4"
    ],
    [
      "M4",
      "M5"
    ],
    [
      "M5",
      "M6"
    ],
    [
      "M6",
      "M7"
    ]
  ]
}