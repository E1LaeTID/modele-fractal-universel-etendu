{
  "name": "square-closed-path",
  "closedPathType": "square",
  "description": "Contour fermé square régulier défini proportionnellement à une longueur de côté commune length = L.",
  "parameters": {
    "length": {
      "symbol": "L",
      "description": "Longueur commune à tous les segments du polygone régulier."
    },
    "offsetX": {
      "symbol": "X0",
      "description": "Translation horizontale appliquée depuis l'origine M0."
    },
    "offsetY": {
      "symbol": "Y0",
      "description": "Translation verticale appliquée depuis l'origine M0."
    }
  },
  "screenTransform": {
    "x": "offsetX + normalizedX * length",
    "y": "offsetY - normalizedY * length"
  },
  "origin": "M0",
  "endPoint": "M0",
  "points": [
    {
      "id": "M0",
      "normalized": [
        "0",
        "0"
      ],
      "x": "offsetX",
      "y": "offsetY"
    },
    {
      "id": "M1",
      "normalized": [
        "1",
        "0"
      ],
      "x": "offsetX + length",
      "y": "offsetY"
    },
    {
      "id": "M2",
      "normalized": [
        "1",
        "1"
      ],
      "x": "offsetX + length",
      "y": "offsetY - length"
    },
    {
      "id": "M3",
      "normalized": [
        "0",
        "1"
      ],
      "x": "offsetX",
      "y": "offsetY - length"
    }
  ],
  "segments": [
    [
      "M0",
      "M1"
    ],
    [
      "M1",
      "M2"
    ],
    [
      "M2",
      "M3"
    ],
    [
      "M3",
      "M0"
    ]
  ]
}
